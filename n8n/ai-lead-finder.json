        "hasOutputParser": true,
        "text": "={{ JSON.stringify($json.structuredContent.result.data.elements.map(e => ({ title: e.title, company: e.company }))) }}",
        "options": {
          "systemMessage": "=You judge a Sales Navigator preview against what the user wants. For each lead in the JSON (title and company only), return {fit: true or false, reason}. A lead fits when its title matches the roles and seniority the user described and nothing in the title or company name contradicts the rest. Mark consultants, advisors, fractional and independent roles as not a fit. The reason is 2 to 6 words, the same wording for the same kind of miss. Never guess facts you cannot see.\n\nWhat the user wants:\n{{ $('Describe your leads').first().json['Who (roles, seniority, country)'] }}, company size {{ ($('Describe your leads').first().json['Company size'] || []).join(', ') || 'any' }}, industry {{ $('Describe your leads').first().json['Industry'] }}.",
          "maxIterations": 3
        }
      },
      "id": "5ae9caaa-80d4-45c3-8b04-870a7667b79c",
      "name": "Judge the preview",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
