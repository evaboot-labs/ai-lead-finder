      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-5-5",
          "cachedResultName": "claude-sonnet-5-5"
        },
        "options": {
          "maxTokensToSample": 4000
        }
      },
      "id": "f38b5f01-f922-400c-aee1-804830bcf74e",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1520,
        200
      ],
      "credentials": {
        "anthropicApi": {
